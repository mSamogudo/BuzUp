# Producao TPM-TUR (tpm-tur.updigital.co.mz) — app do passageiro.
#
# Perfil proprio pelas mesmas razoes do POS: o sufixo .tpmtur deixa a app da
# TPM-TUR conviver com a BuzUp no mesmo aparelho.
BUZUP_API_BASE_URL=https://tpm-tur.updigital.co.mz
BUZUP_MOBILE_APPLICATION_ID=mz.coupdigital.buzup_mobile.tpmtur
MOBILE_FLUTTER_DEVICE=auto
MOBILE_WEB_HOST=127.0.0.1
MOBILE_WEB_PORT=3018
MOBILE_BUILD_MODE=release
# APK universal: e o ficheiro que se entrega ao passageiro por link.
MOBILE_SPLIT_PER_ABI=false
MOBILE_RELEASE_ABI=armeabi-v7a
# Nome sob o icone no telemovel do passageiro.
BUZUP_MOBILE_APP_LABEL=TPM-TUR
