# Producao TPM-TUR (tpm-tur.updigital.co.mz)
#
# Perfil proprio, e nao o `prod` com o URL trocado: o sufixo .tpmtur no
# identificador deixa a app da TPM-TUR conviver com a BuzUp no mesmo terminal.
# Sem isso, instalar uma por cima da outra fazia o agente mudar de servidor
# sem dar por isso.
BUZUP_API_BASE_URL=https://tpm-tur.updigital.co.mz
BUZUP_POS_APPLICATION_ID=mz.coupdigital.pos_app.tpmtur
POS_FLUTTER_DEVICE=android
POS_WEB_HOST=127.0.0.1
POS_WEB_PORT=3013
POS_BUILD_MODE=release
# APK universal: um so ficheiro serve todos os terminais do balcao.
POS_SPLIT_PER_ABI=false
POS_RELEASE_ABI=armeabi-v7a
# Nome sob o icone no terminal do agente.
BUZUP_POS_APP_LABEL="TPM-TUR POS"
